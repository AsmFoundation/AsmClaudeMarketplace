<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds libcalc.so first. Not a managed reference; its output is only collected into @(CalcNativeLibrary). -->
    <ProjectReference Include="../Calc.Native/Calc.Native.asmproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      OutputItemType="CalcNativeLibrary" />
  </ItemGroup>

  <!-- Copy libcalc.so next to Calc.App.dll so DllImport("calc") can find it. -->
  <Target Name="IncludeCalcNativeLibrary" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(CalcNativeLibrary)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
