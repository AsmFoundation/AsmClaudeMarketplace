<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- needed by [LibraryImport] source generation -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds libcalc.so and copies it next to the app; adds no assembly reference. -->
    <ProjectReference Include="../Calc.Native/Calc.Native.asmproj" />
  </ItemGroup>

</Project>
