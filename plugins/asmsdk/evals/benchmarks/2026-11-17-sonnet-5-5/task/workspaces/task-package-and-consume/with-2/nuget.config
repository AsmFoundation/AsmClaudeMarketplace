<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only these two feeds: ignore user-level and machine-level ones. -->
    <clear />
    <!-- Folder feed, filled by: dotnet pack Crc/Crc.asmproj -o packages
         The folder must exist before the first restore (a missing local feed is NU1301), which is why packages/.gitkeep is checked in. -->
    <add key="local" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Start from an empty mapping so a nuget.config in a parent folder or in the user profile
       cannot route Acme.Crc away from the local feed. The most specific pattern wins. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="Acme.*" />
      <!-- The SDK and its toolchain come from nuget.org; listing them here as well also allows a pre-seeded or offline packages/ folder. -->
      <package pattern="AsmFoundation.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="AsmFoundation.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
