<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed, filled by: dotnet pack Crc/Crc.asmproj -o packages
         The path is relative to this file, and the folder must exist (a missing local source fails restore with NU1301). -->
    <add key="local" value="./packages" />
    <!-- Also hosts AsmFoundation.Sdk itself. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
