<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Filled by: dotnet pack Crc/Crc.asmproj -o packages (a relative path is relative to this file). -->
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Start afresh, so a mapping in a parent or user-level nuget.config cannot hide a feed. -->
    <clear />
    <packageSource key="local">
      <package pattern="Acme.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
