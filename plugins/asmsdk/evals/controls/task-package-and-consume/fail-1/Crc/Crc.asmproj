<Project Sdk="AsmFoundation.Sdk">
  <!-- Negative control: crc.inc sits in the project folder, not include/, so dotnet pack ships no
       include file and the tool's %include "crc.inc" fails to assemble. -->
  <PropertyGroup>
    <OutputType>StaticLibrary</OutputType>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <PackageId>Acme.Crc</PackageId>
    <Version>1.2.0</Version>
  </PropertyGroup>
</Project>
